# Application Settings
PROJECT_NAME="HRMS - Human Resource Management System"
API_V1_STR="/api/v1"
SECRET_KEY="supersecret-jwt-key-replace-in-production-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Examples:
# PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/hrms_db
# MySQL: mysql+pymysql://root:password@localhost:3306/hrms_db
# SQLite (Default for out-of-the-box local testing): sqlite:///./hrms.db
DATABASE_URL="sqlite:///./hrms.db"

# Security & CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://localhost:8000"]

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
