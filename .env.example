# Application Settings
PROJECT_NAME="HRMS - Human Resource Management System"
API_V1_STR="/api/v1"
SECRET_KEY="supersecret-jwt-key-replace-in-production-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL Primary Default)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/hrms_db"

# Security & CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://localhost:8000"]

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
